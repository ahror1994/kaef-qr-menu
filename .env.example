# Database (PostgreSQL)
DATABASE_URL="postgresql://kaef:kaef@localhost:5432/kaef_menu?schema=public"

# Public URL of the site (used for SEO/OG tags)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret for signing admin session cookies (generate: openssl rand -base64 32)
AUTH_SECRET="change-me-please-generate-a-long-random-string"

# Initial superadmin (used by `npm run superadmin`; change after first login)
SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_PASSWORD="ChangeMe_2026!"

# Media storage: "local" (default, ./storage/uploads) or "s3"
MEDIA_DRIVER="local"
# S3 settings when MEDIA_DRIVER=s3
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
