generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum MediaType {
  IMAGE
  OTHER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(EDITOR)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  auditLogs    AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String   @default("")
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  sort        Int       @default(0)
  isVisible   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@index([sort])
}

model Product {
  id          String        @id @default(cuid())
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title       String
  description String        @default("")
  price       Int
  weight      String        @default("")
  imageUrl    String        @default("")
  gallery     String[]      @default([])
  cardType    String        @default("gallery") // gallery | string
  isVisible   Boolean       @default(true)
  isFeatured  Boolean       @default(false) // NEW/HIT badge source
  sort        Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
}

model Label {
  id        String   @id @default(cuid())
  name      String   @unique // NEW, HIT, VEG ...
  imageUrl  String
  createdAt DateTime @default(now())
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id        String    @id @default(cuid())
  url       String    @unique
  path      String
  filename  String
  size      Int
  type      MediaType @default(IMAGE)
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String   @default("")
  action    String
  entity    String
  entityId  String   @default("")
  details   String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
}
